# PostgreSQL connection string used by Prisma migrations and API routes.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/projectforge"

# Supabase Auth settings used by browser auth and server-side bearer token validation.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Local development only: bypass Supabase bearer-token auth for API testing.
# Never enable in production.
ENABLE_DEV_AUTH="false"
