# PostgreSQL connection used by Prisma migrations and API routes.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/projectforge?schema=public"

# Supabase Auth configuration used by browser auth and server JWT validation.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional local-only auth bypass. Never enable in production.
ENABLE_DEV_AUTH="false"
